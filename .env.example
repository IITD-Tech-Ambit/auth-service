# auth-service — environment config (local development)

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
GRPC_BIND_ADDRESS=0.0.0.0:50051

# IITD OAuth client (issued by webgroup@cc.iitd.ac.in)
IITD_OAUTH_CLIENT_ID=your_client_id
IITD_OAUTH_CLIENT_SECRET=your_client_secret
IITD_OAUTH_AUTHORIZE_URL=https://oauth.iitd.ac.in/authorize.php
IITD_OAUTH_TOKEN_URL=https://oauth.iitd.ac.in/token.php
IITD_OAUTH_RESOURCE_URL=https://oauth.iitd.ac.in/resource.php
# Must byte-match the Redirect URI registered with the webgroup
OAUTH_REDIRECT_URI=https://researchambit.iitd.ac.in/api/auth/callback
OAUTH_STATE_TTL_SEC=600

# Session (NOT the CMS backend's JWT_SECRET — keep them different)
AUTH_JWT_SECRET=change_me_long_random_string
SESSION_TTL_SEC=604800
SESSION_COOKIE_NAME=ra_session
SESSION_COOKIE_SECURE=true

# Where the browser lands after login (SPA root)
POST_LOGIN_REDIRECT=/

# Data stores
MONGODB_URI=mongodb://localhost:27017/auth_service
USERS_COLLECTION=users
REDIS_URL=redis://localhost:6379

# IITD campus proxy (proxy22.iitd.ac.in) is VM production only — see deploy/prod/proxy.env
# and deploy/prod/docker-compose.yml. Local Mac dev / deploy/dev/docker-compose.yml must not use it.
