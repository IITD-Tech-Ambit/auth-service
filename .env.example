# auth-service — environment config (local development)

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
GRPC_BIND_ADDRESS=0.0.0.0:50051

# Auth master switch. Secure-by-default: unset/true = IITD OAuth enforced.
# Set to false ONLY for local testing — every session then resolves to a mock
# dev user (devuser@iitd.ac.in). MUST remain true/unset in production.
ENABLE_AUTH=true

# IITD OAuth client (issued by webgroup@cc.iitd.ac.in)
IITD_OAUTH_CLIENT_ID=your_client_id
IITD_OAUTH_CLIENT_SECRET=your_client_secret
IITD_OAUTH_AUTHORIZE_URL=https://oauth.iitd.ac.in/authorize.php
IITD_OAUTH_TOKEN_URL=https://oauth.iitd.ac.in/token.php
IITD_OAUTH_RESOURCE_URL=https://oauth.iitd.ac.in/resource.php
# Must byte-match the Redirect URI registered with the webgroup
OAUTH_REDIRECT_URI=https://researchambit.iitd.ac.in/api/auth/callback
OAUTH_STATE_TTL_SEC=600

# Session (NOT the CMS backend's JWT_SECRET — keep them different)
AUTH_JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
SESSION_TTL_SEC=604800
SESSION_COOKIE_NAME=ra_session
SESSION_COOKIE_SECURE=true

# Kerberos ids that may edit any faculty profile. Checked at verify time, never stored in the JWT.
SUPERADMIN_KERBEROS=

# Where the browser lands after login (SPA root)
POST_LOGIN_REDIRECT=/

# Data stores. Keep these on localhost. The VM MongoDB is the production user collection.
MONGODB_URI=mongodb://localhost:27017/auth_service
USERS_COLLECTION=users
REDIS_URL=redis://localhost:6379

# oauth.iitd.ac.in is on the campus network. Token and resource calls connect
# directly and ignore HTTP(S)_PROXY and OAUTH_HTTP_PROXY_URL. Do not send them
# through the institutional forward proxy.
