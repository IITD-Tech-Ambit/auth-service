{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "IITD OAuth 2 identity service for Research Ambit: login/callback/me/logout over HTTP, VerifyToken/GetUser over gRPC",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "for f in src/*.js src/**/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "undici": "^7.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
